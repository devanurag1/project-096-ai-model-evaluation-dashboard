# AI Model Evaluation Dashboard - Environment Configuration
APP_NAME=AI Model Evaluation Dashboard
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Security & Cryptographic Audit
# Replace with high-entropy keys in production deployments
SECRET_KEY=demo-insecure-secret-key-change-in-production-min32chars!
AUDIT_HMAC_KEY=demo-insecure-hmac-key-change-in-production-min32chars!
TOKEN_EXPIRY_MINUTES=480

# Storage Paths
DB_PATH=data/model_eval.db
AUDIT_LEDGER_PATH=data/audit_ledger.jsonl

# Policy Engine Default Thresholds (Control Matrix)
DEFAULT_ACCURACY_THRESHOLD=0.82
DEFAULT_LATENCY_P95_MAX_MS=1200
DEFAULT_COST_PER_1K_MAX_USD=0.015
DEFAULT_SAFETY_PASS_RATE_MIN=0.95
MAX_ALLOWED_JAILBREAK_SCORE=0.05
MAX_ALLOWED_PII_LEAK_RATE=0.00

# Observability
LOG_LEVEL=INFO
ENABLE_MOCK_LLM_ADAPTER=true
